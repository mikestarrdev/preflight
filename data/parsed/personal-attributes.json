[
  {
    "id": "meta:personal-attributes:0.1",
    "platform": "meta",
    "doc_slug": "personal-attributes",
    "doc_title": "Privacy Violations and Personal Attributes",
    "clause_path": "0.1",
    "heading_trail": [
      "Privacy Violations and Personal Attributes"
    ],
    "content": "Ads Must Comply with the Community Standard on Privacy Violations. Ads must not contain content that shares or asks for private information about users. In addition, ads must not contain content that asserts or implies personal attributes. This includes direct or indirect assertions or implications about a person’s race, ethnicity, religion, beliefs, age, sexual orientation or practices, gender identity, disability, physical or mental health (including medical conditions), vulnerable financial status, voting status, membership in a trade union, criminal record, or name.",
    "content_type": "rule",
    "source_url": "https://transparency.meta.com/policies/ad-standards/objectionable-content/privacy-violations-personal-attributes/",
    "fetched_at": "2026-07-22T06:39:57.518Z"
  },
  {
    "id": "meta:personal-attributes:1.1",
    "platform": "meta",
    "doc_slug": "personal-attributes",
    "doc_title": "Privacy Violations and Personal Attributes",
    "clause_path": "1.1",
    "heading_trail": [
      "Privacy Violations and Personal Attributes",
      "Overview"
    ],
    "content": "At Meta, we want people in our community to have a positive experience when they see ads. Ads that make assumptions about people could be perceived as intrusive, unsettling or inaccurate. For this reason, we don't allow advertisers to run ads that assert or imply the personal attributes of their audience. Instead, ads should focus on the benefits of the product or service being advertised.",
    "content_type": "rule",
    "source_url": "https://transparency.meta.com/policies/ad-standards/objectionable-content/privacy-violations-personal-attributes/",
    "fetched_at": "2026-07-22T06:39:57.518Z"
  },
  {
    "id": "meta:personal-attributes:2.1",
    "platform": "meta",
    "doc_slug": "personal-attributes",
    "doc_title": "Privacy Violations and Personal Attributes",
    "clause_path": "2.1",
    "heading_trail": [
      "Privacy Violations and Personal Attributes",
      "Additional Guidelines for Ads"
    ],
    "content": "In addition to the requirements in our Community Standard on Privacy Violations, which prohibits soliciting or sharing certain personal information, Ads can’t:\nShare or ask for personal attributes of a user or user’s family\nImply that the advertiser is aware of someone's personal attributes or the personal attributes of their family\nImply knowledge of personal or organizational financial information of a user or user’s family\nImply that the advertiser is aware of someone’s personally identifiable information, such as their name\nImply knowledge of Medical information of a user or user’s family\nAds can:\nBroadly reference personal attributes that aren’t listed above, such as calling someone “American” or “New Yorker” to reference where they live.\nContain passing reference to a personal attribute. This includes gender, age groups or age ranges.\nInclude names of celebrities or fictional characters.\nUse “you/your” language without a personal attribute.\nMake Public Service Announcements that inform the public about issues related to personal health attributes, as long as they don’t assert someone or their family has a health condition.",
    "content_type": "rule",
    "source_url": "https://transparency.meta.com/policies/ad-standards/objectionable-content/privacy-violations-personal-attributes/",
    "fetched_at": "2026-07-22T06:39:57.518Z"
  },
  {
